# hakuX's core info for RetroArch.
# hakuX-lr 0.38.0 (portare-ch/hakuX-lr), shipped as hakux_libretro.so; its own .info says savestate = "true", but its guide
# says to leave save states, rewind and run-ahead off, and they need Network off and 64 MB. savestate = "false": with no save
# states RetroArch never runs ahead, which would load a second core into its process.
display_name = "Microsoft - Xbox (hakuX)"
authors = "hakuX-lr contributors|hakuX contributors"
supported_extensions = "iso|chd"
corename = "hakuX"
categories = "Emulator"
license = "GPLv3+"
permissions = ""
display_version = "0.38.0 (hakuX-lr)"
manufacturer = "Microsoft"
systemname = "Xbox"
systemid = "xbox"
database = "Microsoft - Xbox"
supports_no_game = "false"
needs_fullpath = "true"
savestate = "false"
savestate_features = "null"
cheats = "false"
input_descriptors = "true"
memory_descriptors = "false"
libretro_saves = "false"
core_options = "true"
core_options_version = "2.0"
load_subsystem = "false"
hw_render = "true"
required_hw_api = "Vulkan >= 1.2"
is_experimental = "true"
description = "Original Xbox games: x86 code on a FEX JIT, a reimplemented Xbox kernel (no BIOS or hard disk image), the NV2A drawn through Vulkan and the MCPX APU."
notes = "(!) ARM64 Linux with Vulkan 1.2; RetroArch's vulkan video driver.|(!) No BIOS, MCPX ROM or hard disk image: the console's disk and caches go in the save directory (hdd/, cache/).|Save states, rewind and run-ahead are not supported."
