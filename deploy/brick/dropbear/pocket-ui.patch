diff -ru a/src/svr-authpasswd.c b/src/svr-authpasswd.c
--- a/src/svr-authpasswd.c
+++ b/src/svr-authpasswd.c
@@ -46,6 +46,31 @@
 	return constant_time_memcmp(a, b, la);
 }
 
+/* pocket-ui on the TrimUI Brick: with DROPBEAR_PASSWORD_FILE set, the password is the one in that file (the device made it and
+ * shows it on screen), compared as it is; the account's own password is not looked at. A missing or unreadable file, or one
+ * shorter than 8 characters, lets nobody in by password. Returns 1 when `given` (of `len` bytes) is that password. */
+static int pocketui_password_ok(const char *file, const char *given, unsigned int len) {
+	char expected[DROPBEAR_MAX_PASSWORD_LEN + 2];
+	size_t n = 0;
+	int ok = 0;
+	FILE *f = fopen(file, "r");
+	if (f == NULL) {
+		dropbear_log(LOG_WARNING, "pocket-ui: no password file, password login refused");
+		return 0;
+	}
+	n = fread(expected, 1, sizeof(expected) - 1, f);
+	fclose(f);
+	expected[n] = '\0';
+	while (n > 0 && (expected[n - 1] == '\n' || expected[n - 1] == '\r' || expected[n - 1] == ' ')) {
+		expected[--n] = '\0';
+	}
+	if (n >= 8 && n <= DROPBEAR_MAX_PASSWORD_LEN && strlen(expected) == n && strlen(given) == len) {
+		ok = constant_time_strcmp(given, expected) == 0;
+	}
+	m_burn(expected, sizeof(expected));
+	return ok;
+}
+
 /* Process a password auth request, sending success or failure messages as
  * appropriate */
 void svr_auth_password(int valid_user) {
@@ -66,9 +91,16 @@
 
 	password = buf_getstring(ses.payload, &passwordlen);
 	if (valid_user && passwordlen <= DROPBEAR_MAX_PASSWORD_LEN) {
+		const char *pocketui_file = getenv("DROPBEAR_PASSWORD_FILE");
+		if (pocketui_file != NULL) {
+			/* Compared here, so the password is burnt below as usual; what follows only sees equal or unequal. */
+			passwdcrypt = "pocket-ui";
+			testcrypt = pocketui_password_ok(pocketui_file, password, passwordlen) ? "pocket-ui" : "refused";
+		} else {
 		/* the first bytes of passwdcrypt are the salt */
 		passwdcrypt = ses.authstate.pw_passwd;
 		testcrypt = crypt(password, passwdcrypt);
+		}
 	}
 	m_burn(password, passwordlen);
 	m_free(password);
