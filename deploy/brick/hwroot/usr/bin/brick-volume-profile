# The built-in codec counts attenuation; the driver's ascending TLV is reversed.
# Curve 3 raises only 1..49%; 50..100% and the maximum keep curve 2's gain.
VOLUME_CURVE=3
volume_raw() {
  if [ "$1" -le 50 ]; then echo $(( ((100 - (20 + $1 * 3 / 5)) * 40 + 50) / 100 ));
  else echo $(( ((100 - $1) * 40 + 50) / 100 )); fi
}
volume_percent() {
  case "$1" in ''|*[!0-9]*) echo 50 ;;
    *) value=$1
       while [ "${value#0}" != "$value" ]; do value=${value#0}; done
       value=${value:-0}
       if [ "${#value}" -gt 3 ] || [ "$value" -gt 100 ]; then echo 100; else echo "$value"; fi ;;
  esac
}
volume_read_percent() {
  saved=$(cat "$STATE/$1" 2>/dev/null)
  case "$saved" in ''|*[!0-9]*) return 1 ;; esac
  [ "$(volume_percent "$saved")" = "$saved" ] || return 1
  echo "$saved"
}
volume_curve_saved() { volume_read_percent brick-volume-curve3; }
volume_saved() { volume_curve_saved || volume_read_percent brick-volume-curve2 || volume_percent "$(cat "$STATE/brick-volume" 2>/dev/null)"; }
volume_compat_curve() {
  curve=$(cat "$STATE/brick-volume-compat" 2>/dev/null)
  # A curve-2 marker cannot identify the legacy file's encoding: curve 3 also
  # writes it while retaining an older rollback format. Unknown tags use the
  # quietest historical interpretation, rather than risking a gain increase.
  case "$curve" in old|new|low) echo "$curve" ;; *) echo old ;; esac
}
volume_legacy_raw() {
  if [ "$1" -eq 0 ]; then echo 63
  elif [ "$2" = low ]; then volume_raw "$1"
  elif [ "$2" = new ]; then echo $(( ((100 - $1) * 40 + 50) / 100 ))
  else echo $((63 - ($1 * 63 + 50) / 100)); fi
}
# ALSA softvol: -51..0 dB, 256 values; raw zero is mute. Same dB curve as the codec.
volume_bt_raw() {
  if [ "$1" -eq 0 ]; then echo 0
  elif [ "$1" -le 50 ]; then echo $((255 - ((100 - (20 + $1 * 3 / 5)) * 232 + 50) / 100))
  else echo $((255 - ((100 - $1) * 232 + 50) / 100)); fi
}
volume_legacy_bt_raw() {
  if [ "$1" -eq 0 ]; then echo 0
  elif [ "$2" = low ]; then volume_bt_raw "$1"
  elif [ "$2" = new ]; then echo $((255 - ((100 - $1) * 232 + 50) / 100))
  else echo $(($1 * 255 / 100)); fi
}
# Highest representable percentage that cannot amplify EITHER output on import/rollback.
# The codec's 1.16 dB quantisation and Bluetooth's 0.2 dB ticks need separate bounds.
volume_from_gain() {
  case "$3" in
    low) if [ "$1" -gt 20 ]; then candidate=$(((5 * ((4050 - $1 * 100) / 40 - 19) - 1) / 3)); else candidate=$(((4050 - $1 * 100) / 40)); fi ;;
    new) candidate=$(((4050 - $1 * 100) / 40)) ;;
    old) candidate=$(((6349 - $1 * 100) / 63)) ;;
    *) return 1 ;;
  esac
  [ "$candidate" -le 100 ] || candidate=100
  [ "$candidate" -ge 0 ] || candidate=0
  while [ "$candidate" -gt 0 ]; do
    if [ "$(volume_legacy_raw "$candidate" "$3")" -ge "$1" ] && [ "$(volume_legacy_bt_raw "$candidate" "$3")" -le "$2" ]; then echo "$candidate"; return; fi
    candidate=$((candidate - 1))
  done
  echo 0
}
