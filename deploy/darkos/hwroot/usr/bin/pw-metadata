#!/bin/sh
# dArkOS port (docs/DARKOS.md): pocket-ui leaves dArkOS's network, Bluetooth, clock and services as they are. `pw-metadata` is not
# available here (exit 1), so pocket-ui shows its "not available" path and changes nothing.
echo "pw-metadata: not available in pocket-ui on dArkOS" >&2
exit 1
