// pocket-ui's Steam Input layout for the Steam Deck (controller_neptune), docs/STEAMDECK.md "Controller".
// It is Valve's plain Gamepad template plus what pocket-ui needs from the Deck's own parts:
//   L4 = L1, R4 = R1 (the upper back buttons repeat the bumpers: paging in the menus, HOME+L4 loads, HOME+R4 saves)
//   L5 and R5 = Guide, pocket-ui's HOME (pause menu in a game, quick settings on the shelf). The Steam button and
//     the "..." quick-access button stay Steam's: its overlay, Exit Game and the performance menu never fight HOME.
//   Right trackpad = mouse (click = tap), left trackpad = scroll wheel: in pocket-ui's menus both work like a
//     finger; in a game the emulator owns them.
// install.sh copies this file to Steam's controller_base/templates; pick it once per Steam (pocket-ui >
// Controller settings > Templates > "pocket-ui"). Written from Valve's template format without a Deck to load it
// on: the first real Deck session must confirm Steam accepts it (docs/STEAMDECK.md). The stock "Gamepad"
// template is the fallback and differs only in the back buttons and the trackpads.
"controller_mappings"
{
	"version"		"3"
	"controller_type"		"controller_neptune"
	"name"		"pocket-ui"
	"description"		"Gamepad for pocket-ui: L4/R4 repeat the bumpers, L5/R5 are HOME, right trackpad is a mouse, left one scrolls."
	"localization"
	{
		"english"
		{
			"name"		"pocket-ui"
			"description"		"Gamepad for pocket-ui: L4/R4 repeat the bumpers, L5/R5 are HOME, right trackpad is a mouse, left one scrolls."
		}
	}
	"group"
	{
		"id"		"0"
		"mode"		"four_buttons"
		"name"		"Button Diamond"
		"description"		"Button Diamond"
		"buttons"
		{
			"button_north"		"xinput_button Y"
			"button_east"		"xinput_button B"
			"button_west"		"xinput_button X"
			"button_south"		"xinput_button A"
		}
	}
	"group"
	{
		"id"		"1"
		"mode"		"dpad"
		"name"		"Directional Pad"
		"description"		"Directional Pad"
		"settings"
		{
			"requires_click"		"0"
		}
		"buttons"
		{
			"dpad_north"		"xinput_button DPAD_UP"
			"dpad_south"		"xinput_button DPAD_DOWN"
			"dpad_west"		"xinput_button DPAD_LEFT"
			"dpad_east"		"xinput_button DPAD_RIGHT"
		}
	}
	"group"
	{
		"id"		"2"
		"mode"		"joystick_move"
		"name"		"Left Joystick"
		"description"		"Left Joystick"
		"buttons"
		{
			"click"		"xinput_button LEFT_STICK_CLICK"
		}
	}
	"group"
	{
		"id"		"3"
		"mode"		"joystick_move"
		"name"		"Right Joystick"
		"description"		"Right Joystick"
		"buttons"
		{
			"click"		"xinput_button RIGHT_STICK_CLICK"
		}
	}
	"group"
	{
		"id"		"4"
		"mode"		"trigger"
		"name"		"Left Trigger"
		"description"		"Left Trigger"
		"buttons"
		{
			"full_pull"		"xinput_button LEFT_TRIGGER"
			"soft_pull"		"xinput_button LEFT_TRIGGER"
		}
	}
	"group"
	{
		"id"		"5"
		"mode"		"trigger"
		"name"		"Right Trigger"
		"description"		"Right Trigger"
		"buttons"
		{
			"full_pull"		"xinput_button RIGHT_TRIGGER"
			"soft_pull"		"xinput_button RIGHT_TRIGGER"
		}
	}
	"group"
	{
		"id"		"6"
		"mode"		"mouse"
		"name"		"Right Trackpad"
		"description"		"Right Trackpad: mouse in the menus, a click taps"
		"settings"
		{
			"requires_click"		"0"
		}
		"buttons"
		{
			"click"		"mouse_button LEFT"
		}
	}
	"group"
	{
		"id"		"7"
		"mode"		"scrollwheel"
		"name"		"Left Trackpad"
		"description"		"Left Trackpad: scrolls the lists"
		"settings"
		{
			"requires_click"		"0"
		}
	}
	"preset"
	{
		"id"		"0"
		"name"		"Default"
		"description"		"Default"
		"group_source_bindings"
		{
			"0"		"button_diamond active"
			"1"		"dpad active"
			"2"		"joystick active"
			"3"		"right_joystick active"
			"4"		"left_trigger active"
			"5"		"right_trigger active"
			"6"		"right_trackpad active"
			"7"		"left_trackpad active"
		}
		"switch_bindings"
		{
			"bindings"
			{
				"button_escape"		"xinput_button START"
				"button_back"		"xinput_button BACK"
				"left_bumper"		"xinput_button LEFT_BUMPER"
				"right_bumper"		"xinput_button RIGHT_BUMPER"
				"button_grip_left_upper"		"xinput_button LEFT_BUMPER"
				"button_grip_right_upper"		"xinput_button RIGHT_BUMPER"
				"button_grip_left"		"xinput_button GUIDE"
				"button_grip_right"		"xinput_button GUIDE"
			}
		}
		"settings"
		{
		}
	}
}
