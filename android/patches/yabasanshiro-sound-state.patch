@@ -21,6 +21,8 @@
 \brief Musashi 68000 interface.
 */
 
+#include <stddef.h>
+#include "memory.h"
 #include "m68kmusashi.h"
 #include "musashi/m68k.h"
 #include "m68kcore.h"
@@ -166,9 +168,22 @@
 }
 
 static void M68KMusashiSaveState(FILE *fp) {
+   m68ki_cpu_core context;
+   IOCheck_struct check = {0, 0};
+   /* All fields before the cycle-table pointers are 32-bit CPU values.
+    * Never save host pointers: a Continue may run at different ASLR addresses. */
+   _Static_assert(offsetof(m68ki_cpu_core, cyc_instruction) == MUSASHI_STATE_BYTES,
+                  "Musashi state layout changed");
+   m68k_get_context(&context);
+   ywrite(&check, &context, MUSASHI_STATE_BYTES, 1, fp);
 }
 
 static void M68KMusashiLoadState(FILE *fp) {
+   m68ki_cpu_core context;
+   IOCheck_struct check = {0, 0};
+   m68k_get_context(&context);
+   yread(&check, &context, MUSASHI_STATE_BYTES, 1, fp);
+   m68k_set_context(&context);
 }
 
 M68K_struct M68KMusashi = {
