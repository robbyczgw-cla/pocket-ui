+// Shared DS actions: right stick moves the stylus, R2 touches, R3 changes layout.
+// Physical touches remain libretro pointers across the currently presented frame.
+struct Screen { unsigned x, y, w, h; };
+struct Layout { unsigned w, h; Screen top, bottom; const char* name; };
+constexpr Layout layouts[] = {
+  {W,H*2,{0,0,W,H},{0,H,W,H},"top-bottom"},
+  {W,H*2,{0,H,W,H},{0,0,W,H},"bottom-top"},
