+void geometry(retro_game_geometry& g) {
+  const auto& l=layouts[layout_id];
+  g={l.w,l.h,W*2,H*2,float(l.w)/float(l.h)};
+}
+void select_layout(unsigned id) {
+  layout_id=id % (sizeof layouts/sizeof *layouts);
+  layout_setting=layouts[layout_id].name;
+  retro_variable setting{"dsperate_screen_layout",layout_setting.c_str()};
+  env_cb(RETRO_ENVIRONMENT_SET_VARIABLE,&setting);
+  retro_game_geometry g{};geometry(g);
+  env_cb(RETRO_ENVIRONMENT_SET_GEOMETRY,&g);
+}
+void read_layout() {
+  retro_variable v{"dsperate_screen_layout",nullptr};
+  if(!env_cb(RETRO_ENVIRONMENT_GET_VARIABLE,&v)||!v.value||layout_setting==v.value)return;
+  layout_setting=v.value;
+  for(unsigned i=0;i<sizeof layouts/sizeof *layouts;i++)
+    if(layout_setting==layouts[i].name){select_layout(i);break;}
+}
+void stylus(ds::input::Frame& in) {
+  const bool held=input_state_cb(0,RETRO_DEVICE_JOYPAD,0,RETRO_DEVICE_ID_JOYPAD_R3);
+  if(held&&!layout_held)select_layout(layout_id+1);
+  layout_held=held;
+  bool changed=false;
+  for(unsigned axis=0;axis<2;axis++) {
+    const int value=input_state_cb(0,RETRO_DEVICE_ANALOG,RETRO_DEVICE_INDEX_ANALOG_RIGHT,axis);
+    if(value>4096||value< -4096) {
+      float& coord=axis?cursor_y:cursor_x;
+      coord=std::clamp(coord+float(value)*4.0f/32767.0f,0.0f,float((axis?H:W)-1));
+      changed=true;
+    }
+  }
+  if(input_state_cb(0,RETRO_DEVICE_JOYPAD,0,RETRO_DEVICE_ID_JOYPAD_R2)) {
+    in.down=true;in.x=static_cast<ds::u8>(cursor_x);in.y=static_cast<ds::u8>(cursor_y);changed=true;
+  }
+  if(changed)cursor_life=120;else if(cursor_life)--cursor_life;
+  if(!input_state_cb(0,RETRO_DEVICE_POINTER,0,RETRO_DEVICE_ID_POINTER_PRESSED))return;
+  const auto& l=layouts[layout_id];const auto& r=l.bottom;
+  const int px=input_state_cb(0,RETRO_DEVICE_POINTER,0,RETRO_DEVICE_ID_POINTER_X);
+  const int py=input_state_cb(0,RETRO_DEVICE_POINTER,0,RETRO_DEVICE_ID_POINTER_Y);
+  const int x=std::clamp((px+32767)*int(l.w)/65534,0,int(l.w)-1);
+  const int y=std::clamp((py+32767)*int(l.h)/65534,0,int(l.h)-1);
+  if(r.w&&x>=int(r.x)&&y>=int(r.y)&&x<int(r.x+r.w)&&y<int(r.y+r.h)) {
+    in.down=true;in.x=x-r.x;in.y=y-r.y;
+    cursor_x=in.x;cursor_y=in.y;cursor_life=0;
+  }
+}
+void picture() {
+  const auto& l=layouts[layout_id];
+  const Screen screens[]={l.top,l.bottom};
+  for(unsigned i=0;i<2;i++) {
+    const auto& r=screens[i];if(!r.w)continue;
+    const auto* source=nds->gpu.framebuffer(i);
+    for(unsigned y=0;y<r.h;y++)std::memcpy(frame+(r.y+y)*l.w+r.x,source+y*W,W*4);
+  }
+  if(cursor_life&&l.bottom.w) {
+    const int x=static_cast<int>(cursor_x),y=static_cast<int>(cursor_y);
+    auto dot=[&](int dx,int dy,uint32_t color){
+      const int u=x+dx,v=y+dy;
+      if(u>=0&&v>=0&&u<int(W)&&v<int(H))frame[(l.bottom.y+v)*l.w+l.bottom.x+u]=color;
+    };
+    for(int i=-5;i<=5;i++)for(int d=-1;d<=1;d++){dot(i,d,0xff000000);dot(d,i,0xff000000);}
+    for(int i=-4;i<=4;i++){dot(i,0,0xffffffff);dot(0,i,0xffffffff);}
+  }
+  video_cb(frame,l.w,l.h,l.w*4);
+}
