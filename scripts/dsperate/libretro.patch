+set(DSPERATE_PGO OFF CACHE STRING "" FORCE)
+add_compile_options(-fno-semantic-interposition)
+add_subdirectory(DSperate engine EXCLUDE_FROM_ALL)
+execute_process(COMMAND git -C "${CMAKE_CURRENT_SOURCE_DIR}/DSperate" describe --tags --always
