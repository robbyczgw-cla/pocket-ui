# Copy to scripts/local.env (not tracked) and fill in the address of your Retroid Pocket Mini V2.
# Read by scripts/host.sh for dev.sh, syscheck.sh, hwplay.sh, harden-ssh.sh and autostart.sh.
# An exported POCKETUI_HOST in your shell wins over this file.
POCKETUI_HOST=root@<device-ip>

# The Wi-Fi bench (docs/WIFI-BENCH.md): the SSH host of a Mac with colima it runs on, or "local".
# WIFI_BENCH_HOST=<ssh host>

# The audio bench (scripts/audio-bench/README.md): the SSH host with docker and the vdev base image, or "local".
# AUDIO_BENCH_HOST=<ssh host>

# The lock file scripts/big-emu-bench.sh takes (flock, one per game) so it does not run beside other sessions on the device.
# BIGEMU_LOCK=/tmp/<your-device>.lock
